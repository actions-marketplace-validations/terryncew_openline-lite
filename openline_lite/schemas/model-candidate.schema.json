{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "present"
                }
              }
            },
            "then": {
              "properties": {
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "absent"
                }
              }
            },
            "then": {
              "properties": {
                "sha256": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "present",
              "absent"
            ]
          }
        },
        "required": [
          "path",
          "status",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "support_fact_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "text": {
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "support_fact_ids"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "facts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_path": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "expected": {},
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "pointer": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "evidence_path",
          "evidence_sha256",
          "pointer",
          "expected"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "input_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "olp.model_candidate.v1"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "task_packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "unresolved": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 2048,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "description"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "task_id",
    "input_state_sha256",
    "task_packet_sha256",
    "producer",
    "changes",
    "facts",
    "claims",
    "unresolved"
  ],
  "title": "OpenLine Lite model handoff candidate v1",
  "type": "object"
}
